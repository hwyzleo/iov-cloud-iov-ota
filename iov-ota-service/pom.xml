<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>net.hwyz.iov.cloud.parent</groupId>
        <artifactId>service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>net.hwyz.iov.cloud.ota</groupId>
    <artifactId>iov-ota-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <properties>
        <skipTests>false</skipTests>
        <!-- CR-014: PAR-PROTO canonical Proto SSOT（common/fota/vagw 同 release 固定） -->
        <par-proto.version>0.0.1-SNAPSHOT</par-proto.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>net.hwyz.iov.cloud.iov</groupId>
            <artifactId>iov-ota-api</artifactId>
        </dependency>
        <dependency>
            <groupId>net.hwyz.iov.cloud.edd</groupId>
            <artifactId>edd-vmd-api</artifactId>
        </dependency>
        <dependency>
            <groupId>net.hwyz.iov.cloud.edd</groupId>
            <artifactId>edd-mdm-api</artifactId>
        </dependency>

        <!-- 框架: Security（KMS签名/加密） -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.framework</groupId>
            <artifactId>framework-security-starter</artifactId>
        </dependency>

        <!-- 框架: MySQL -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.framework</groupId>
            <artifactId>framework-mysql-starter</artifactId>
        </dependency>

        <!-- 数据库迁移: Flyway -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- 框架: Redis -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.framework</groupId>
            <artifactId>framework-redis-starter</artifactId>
        </dependency>

        <!-- 框架: Kafka -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.framework</groupId>
            <artifactId>framework-kafka-starter</artifactId>
        </dependency>

        <!-- CR-014: PAR-PROTO 车云协议制品（canonical Proto SSOT，禁止依赖 VEH-PROTO/本地 .proto）
             common=Envelope；fota=FOTA 业务 payload；vagw=云内技术投递状态 -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.proto</groupId>
            <artifactId>proto-vehicle-common</artifactId>
            <version>${par-proto.version}</version>
        </dependency>
        <dependency>
            <groupId>net.hwyz.iov.cloud.proto</groupId>
            <artifactId>proto-fota</artifactId>
            <version>${par-proto.version}</version>
        </dependency>
        <dependency>
            <groupId>net.hwyz.iov.cloud.proto</groupId>
            <artifactId>proto-vagw</artifactId>
            <version>${par-proto.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java-util</artifactId>
            <version>3.25.5</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>${skipTests}</skip>
                    <skipTests>${skipTests}</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>